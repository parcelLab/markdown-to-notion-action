{
  "name": "markdown-to-notion-action",
  "version": "3.0.0",
  "description": "Syncs Markdown files to Notion database items.",
  "license": "MIT",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "start": "tsx src/main.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "hooks:install": "git config core.hooksPath .githooks",
    "precommit": "npm run format && npm run typecheck && npm run lint && npm test && npm run knip",
    "test": "tsx --import ./test/setup.ts --test test/**/*.test.ts"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@notionhq/client": "^5.26.0",
    "@tryfabric/martian": "^1.2.4",
    "js-yaml": "^5.4.1",
    "markdown-it": "^15.0.1",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^74.0.0",
    "knip": "^6.34.0",
    "nock": "^14.0.17",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "katex": "0.16.45"
  }
}
